   "source": [
    "## 3. Limpieza básica y primera exploración\n",
    "\n",
    "Encontré que `TotalCharges` podía llegar como texto y con espacios vacíos, así que lo convertí a número. A los clientes nuevos, que tenían cero meses y el cargo total vacío, les asigné 0. Los otros valores faltantes los completé durante el modelado."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "3a45065e",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-10T12:03:58.191863Z",
     "iopub.status.busy": "2026-10-10T12:03:58.191576Z",
     "iopub.status.idle": "2026-10-10T12:03:58.207930Z",
     "shell.execute_reply": "2026-10-10T12:03:58.206861Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Filas después de la limpieza: 7043\n",
      "Proporción de bajas:\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "Churn\n",
       "0    0.73463\n",
       "1    0.26537\n",
       "Name: proporción, dtype: float64"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "df = df_original.copy()\n",
    "\n",
    "# Cambié el tipo de esta columna porque como texto no servía para los cálculos.\n",
    "df[\"TotalCharges\"] = pd.to_numeric(df[\"TotalCharges\"], errors=\"coerce\")\n",
    "\n",
    "# Tomé como clientes nuevos las filas sin TotalCharges y con tenure igual a cero.\n",
    "clientes_nuevos = (df[\"tenure\"] == 0) & (df[\"TotalCharges\"].isna())\n",
    "df.loc[clientes_nuevos, \"TotalCharges\"] = 0\n",
    "\n",
    "# Convertí la respuesta Yes/No a 1/0 para que el modelo pudiera aprenderla.\n",
    "df[\"Churn\"] = df[\"Churn\"].map({\"No\": 0, \"Yes\": 1})\n",
    "\n",
    "# Quité las filas sin identificador o sin respuesta porque no servían para entrenar.\n",
    "df = df.dropna(subset=[\"customerID\", \"Churn\"]).copy()\n",
    "\n",
    "print(\"Filas después de la limpieza:\", len(df))\n",
    "print(\"Proporción de bajas:\")\n",
    "display(df[\"Churn\"].value_counts(normalize=True).rename(\"proporción\"))\n"
   ]
  },
